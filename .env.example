# Required in production: Supabase project API settings.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only key for one-time data imports. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional Titan shared-mailbox integration. These are server-only values: do
# not prefix them with NEXT_PUBLIC_ and do not commit a real mailbox password.
# Enable third-party access in Titan first. When Titan 2FA is enabled, use an
# application password rather than the normal mailbox password.
TITAN_EMAIL=info@yourdomain.com
TITAN_PASSWORD=your_titan_app_password
# GoDaddy Professional Email powered by Titan defaults:
TITAN_IMAP_HOST=imap.secureserver.net
TITAN_IMAP_PORT=993
TITAN_SMTP_HOST=smtpout.secureserver.net
TITAN_SMTP_PORT=465

# Optional legacy Firebase fallback. Leave blank when using Supabase.
# Copy these values from Firebase Console > Project settings > General > Your apps > Web app config.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id_optional

# Optional local-only fallback password when Firebase is not configured.
APP_LOGIN_PASSWORD=change_this_password
# Use a separate long random value in production to sign secure session cookies.
APP_SESSION_SECRET=replace_with_a_long_random_secret
