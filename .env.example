# Required in production: Supabase project API settings.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional legacy Firebase fallback. Leave blank when using Supabase.
# Copy these values from Firebase Console > Project settings > General > Your apps > Web app config.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id_optional

# Optional local-only fallback password when Firebase is not configured.
APP_LOGIN_PASSWORD=change_this_password
# Use a separate long random value in production to sign secure session cookies.
APP_SESSION_SECRET=replace_with_a_long_random_secret
